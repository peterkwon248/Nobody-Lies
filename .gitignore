node_modules/
dist/
build/
.DS_Store
Thumbs.db
*.log

# OMC 런타임 상태는 기계마다 다르므로 커밋하지 않는다.
# 단 worklog 는 before-work / after-work 가 기계 사이를 오갈 때 읽는
# 유일한 인계 파일이므로 반드시 커밋한다.
.omc/*
!.omc/worklog/

# 기계별 로컬 권한 설정. .claude/settings.json 은 공유해도 된다.
.claude/settings.local.json

# bkit 세션 런타임 상태. 기계마다 다르므로 커밋하지 않는다.
**/.bkit-memory.json
**/.pdca-status.json

# 사건 JSON 은 engine 이 YAML 에서 방출하는 빌드 산출물이다
app/public/cases/
app/dist/

# 생성 사건 임시 방출 (--emit 산출물) · 테스터용 단일 HTML 도 여기 나온다
out/

# 테스터용 단일 HTML 의 중간 산출물 (npm run tester 가 다시 만든다)
app/dist-single/

# 생성 산출물 기준선 (2MB+). 도구는 커밋하고 산출물은 재생성한다 — engine/src/gen-baseline.ts
engine/.gen-baseline.json

# 감사 캡처 — 스크립트로 재생성한다 (scripts/design-audit.mjs)
docs/audit-shots/
