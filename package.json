{
  "name": "nobody-lies",
  "version": "0.1.0",
  "private": true,
  "description": "노바디 라이즈 — 추리 게임",
  "workspaces": [
    "engine",
    "app"
  ],
  "scripts": {
    "build": "npm run typecheck -w engine && npm run lint && npm run yaml-check && npm run verify -w engine && npm run gen-check && npm run prop-check && npm run tmpl-check && npm run brief-check && npm run port-check && npm run build -w nobody-lies-app",
    "typecheck": "npm run typecheck -w engine",
    "lint": "biome lint",
    "prop-check": "npm run prop-check -w engine",
    "verify": "npm run verify -w engine",
    "gen-check": "npm run verify -w engine -- --generate 40 --min-pass 100",
    "tmpl-check": "npm run verify -w engine -- --case templates/case-template.yaml",
    "case": "npm run export-case -w nobody-lies-engine",
    "tester": "npm run build:single -w nobody-lies-app && node scripts/bundle-single.mjs",
    "dev": "npm run dev -w nobody-lies-app",
    "port-check": "node scripts/port-check.mjs",
    "yaml-check": "node scripts/yaml-comma-check.mjs",
    "brief-check": "node scripts/brief-check.mjs",
    "voice-check": "node scripts/voice-check.mjs",
    "world-check": "node scripts/world-check.mjs",
    "plan-check": "npm run plan-check -w engine --",
    "lock-fix": "node scripts/lock-peer-restore.mjs",
    "proof-check": "npm run proof-check -w engine --"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6"
  }
}
