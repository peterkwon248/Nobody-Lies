{
  "name": "nobody-lies",
  "version": "0.1.0",
  "private": true,
  "description": "노바디 라이즈 — 추리 게임",
  "workspaces": [
    "engine",
    "app"
  ],
  "scripts": {
    "build": "npm run typecheck -w engine && npm run lint && npm run yaml-check && npm run verify -w engine && npm run gen-check && npm run prop-check && npm run clue-check && npm run tmpl-check && npm run brief-check && npm run prose-lock && npm run censor-check && npm run solve-check && npm run matrix-check && npm run case && npm run cand-check && npm run port-check && npm run build -w nobody-lies-app",
    "typecheck": "npm run typecheck -w engine",
    "lint": "biome lint",
    "prop-check": "npm run prop-check -w engine",
    "verify": "npm run verify -w engine",
    "gen-check": "npm run verify -w engine -- --generate 40 --min-pass 100",
    "tmpl-check": "npm run verify -w engine -- --case templates/case-template.yaml",
    "prose-lock": "npm run prose-lock -w engine",
    "case": "npm run export-case -w nobody-lies-engine",
    "tester": "npm run build:single -w nobody-lies-app && node scripts/bundle-single.mjs",
    "dev": "npm run dev -w nobody-lies-app",
    "port-check": "node scripts/port-check.mjs",
    "cand-check": "node scripts/cand-check.mjs",
    "yaml-check": "node scripts/yaml-comma-check.mjs",
    "brief-check": "node scripts/brief-check.mjs",
    "voice-check": "node scripts/voice-check.mjs",
    "world-check": "node scripts/world-check.mjs",
    "plan-check": "npm run plan-check -w engine --",
    "lock-fix": "node scripts/lock-peer-restore.mjs",
    "proof-check": "npm run proof-check -w engine --",
    "clue-check": "npm run clue-check -w engine -- 40",
    "mute-check": "npm run mute-check -w engine --",
    "matrix": "npm run matrix -w engine",
    "matrix-check": "npm run matrix -w engine -- --brief",
    "censor-check": "npm run censor-check -w engine",
    "solve-check": "npm run solve-check -w engine -- 40",
    "censor": "npm run censor -w engine --",
    "candidates": "npm run candidates -w engine --",
    "space-audit": "npm run space-audit -w engine",
    "design-audit": "node scripts/design-audit.mjs",
    "token-audit": "node scripts/token-audit.mjs",
    "focus-check": "node scripts/focus-check.mjs",
    "reveal-check": "node scripts/reveal-check.mjs",
    "reveal-shots": "node scripts/reveal-shots.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "playwright-core": "^1.62.1"
  }
}
